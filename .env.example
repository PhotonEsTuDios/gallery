# Kopiere diese Datei nach .env und fülle die Werte.
# .env ist gitignored und wird NIE committet.

# Galerie-Passwort (serverseitig geprüft, nie im Client)
GALLERY_PASSWORD=changeme

# Secret zum Signieren des Session-Cookies (lange Zufallskette)
# erzeugen z.B. mit:  openssl rand -hex 32
SESSION_SECRET=

# AWS – lokal über das Profil "photon"; in Lambda über die Exec-Rolle
AWS_REGION=eu-west-1
PHOTOS_BUCKET=photonestudios-photos
PHOTOS_TABLE=photonestudios-photos
